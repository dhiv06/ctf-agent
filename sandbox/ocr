#!/usr/bin/env python3
"""ocr IMAGE - read text out of an image with tesseract, trying several preprocessing variants.

Prints the text of each variant and any flag-shaped string found (also with OCR-inserted spaces removed).
Preprocessed copies are written to /tmp/ocr_*.png so you can inspect them with other tools."""
import re
import shutil
import subprocess
import sys

from PIL import Image, ImageOps

FLAG = re.compile(r"(academy|picoCTF)\{[^}]*\}", re.I)


def variants(img):
    g = ImageOps.autocontrast(img.convert("L"))
    big = g.resize((g.width * 3, g.height * 3), Image.LANCZOS)
    yield "original", img.convert("RGB")
    yield "gray x3", big
    yield "threshold", big.point(lambda p: 255 if p > 128 else 0)
    yield "inverted", ImageOps.invert(big)
    yield "inverted threshold", ImageOps.invert(big).point(lambda p: 255 if p > 128 else 0)


def tesseract(path, psm):
    p = subprocess.run(["tesseract", path, "stdout", "--psm", str(psm)], capture_output=True,
                       text=True, errors="replace", timeout=60)
    return p.stdout.strip()


def main():
    if len(sys.argv) != 2:
        sys.exit("usage: ocr IMAGE")
    if not shutil.which("tesseract"):
        sys.exit("tesseract is not installed")
    img = Image.open(sys.argv[1])
    print(f"{sys.argv[1]}: {img.width}x{img.height} {img.mode}")
    found = []
    for i, (name, im) in enumerate(variants(img)):
        path = f"/tmp/ocr_{i}.png"
        im.save(path)
        for psm in (6, 11):  # 6 = block of text, 11 = sparse text anywhere
            text = tesseract(path, psm)
            hits = FLAG.findall(text) and [m.group(0) for m in FLAG.finditer(text)]
            hits = hits or [m.group(0) for m in FLAG.finditer(re.sub(r"\s+", "", text))]
            shown = re.sub(r"\s+", " ", text)[:300]
            print(f"\n[{name}, psm {psm}] {shown or '(nothing)'}")
            for h in hits:
                print("  FLAG FOUND:", h)
                found.append(h)
    print("\nflag candidates:", sorted(set(found)) if found else "none (OCR output may be partly wrong; compare variants)")


main()
